// ============================================================================
// nextflow.config — Wheat FHB Multi-Study RNA-seq Pipeline
// ============================================================================
// Organism : Triticum aestivum (hexaploid bread wheat)
// Samples  : 501 libraries | 466 PAIRED + 35 SINGLE-end
// Studies  : 15 distinct studies (see MASTER_EXECUTION_GUIDE for full table)
// Focus    : Fusarium Head Blight (FHB) resistance — spike/spikelet/rachis
// Genome   : IWGSC RefSeq v2.1 (Ensembl Plants release 57)
// Pipeline : nf-core/rnaseq v3.14.0
// ============================================================================

params {
    // Input samplesheet generated by nf-core/fetchngs
    // fetchngs auto-detects SE vs PE per sample from SRA metadata
    input   = './raw_data/samplesheet/samplesheet.csv'

    // S3 output — S3 Standard for instant access
    outdir  = 's3://my-bingya-bucket/Wheat_FHB/results/'

    // IWGSC RefSeq v2.1 — the current gold standard for wheat
    // Upload genome to S3 before running (see MASTER_EXECUTION_GUIDE Phase 3)
    fasta   = 's3://my-bingya-bucket/Wheat_FHB/genome/Triticum_aestivum.IWGSC.dna.toplevel.fa.gz'
    gtf     = 's3://my-bingya-bucket/Wheat_FHB/genome/Triticum_aestivum.IWGSC.57.gtf.gz'

    // STAR + Salmon quantification
    aligner = 'star_salmon'

    // Trimming: keep enabled — libraries span 4 instruments with different
    // adapter contamination profiles (GAIIx, HiSeq 2000/2500/4000, BGISEQ-500)
    skip_trimming = false

    // Skip trimgalore adapter auto-detection per sample (faster for 501 samples)
    // TruSeq Universal adapter covers most Illumina libraries here
    // BGISEQ-500 SE samples use BGI adapter — fetchngs handles this automatically

    // Salmon index options — large hexaploid genome needs extra memory
    extra_salmon_quant_args = '--gcBias --seqBias --numBootstraps 100'

    // MultiQC report title
    multiqc_title = 'Wheat FHB Multi-Study RNA-seq QC (501 libraries, 15 studies)'

    email = 'binodgyawali@gmail.com'
}

// ============================================================================
// AUTO-CLEANUP: removes work/ scratch dir (~500 GB+) after successful run
// ============================================================================
cleanup = true

// ============================================================================
// DOCKER
// ============================================================================
docker {
    enabled    = true
    runOptions = '-u $(id -u):$(id -g)'
}

// ============================================================================
// AWS
// ============================================================================
aws {
    region = 'us-east-1'
    client {
        maxConnections    = 40
        connectionTimeout = 10000
        uploadChunkSize   = '200MB'
        maxErrorRetry     = 5
    }
}

// ============================================================================
// PROCESS RESOURCES
// ============================================================================
// 501 samples × hexaploid wheat genome (~15 GB STAR index) requires
// high-memory instance. Recommended: r5.8xlarge (32 vCPU, 256 GB RAM)
// or run STAR genome generation on r5.24xlarge then use r5.8xlarge for alignment.
process {
    executor = 'local'

    withName: 'STAR_GENOMEGENERATE' {
        memory = { 240.GB * task.attempt }
        cpus   = 32
        time   = { 12.h  * task.attempt }
    }
    withLabel: 'process_high' {
        memory = { 120.GB * task.attempt }
        cpus   = 16
        time   = { 12.h  * task.attempt }
    }
    withLabel: 'process_medium' {
        memory = { 60.GB  * task.attempt }
        cpus   = 8
        time   = { 6.h   * task.attempt }
    }
    withLabel: 'process_low' {
        memory = { 16.GB  * task.attempt }
        cpus   = 4
        time   = { 2.h   * task.attempt }
    }
    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 2
}

// ============================================================================
// EMAIL NOTIFICATIONS
// ============================================================================
notification {
    enabled = true
    to      = '${params.email}'
}

// Uncomment for AWS SES:
/*
